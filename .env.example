# Runtime environment: local | staging | production
# AUTH_DISABLED is rejected at process start unless ENVIRONMENT=local.
ENVIRONMENT=local
AUTH_DISABLED=false

# HTTP
HTTP_ADDR=:8080
LOG_LEVEL=info

# ThunderID / OIDC (placeholders — do not commit real secrets)
OIDC_ISSUER=http://localhost:8090
OIDC_JWKS_URL=http://thunderid:8090/oauth2/jwks
OIDC_TOKEN_URL=http://thunderid:8090/oauth2/token
# Local-only development M2M values. The dev OIDC shim does not authenticate
# client secrets; use separate real values for every service outside Compose.
ORDER_M2M_CLIENT_SECRET=local-order-m2m
PLANNING_M2M_CLIENT_SECRET=local-planning-m2m
LOADING_M2M_CLIENT_SECRET=local-loading-m2m
DELIVERY_M2M_CLIENT_SECRET=local-delivery-m2m
SHARED_M2M_CLIENT_SECRET=local-shared-m2m
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
INTEGRATION_M2M_CLIENT_SECRET=local-integration-m2m
TWILIO_STATUS_CALLBACK_URL=
OIDC_AUDIENCE=waypoint-api
WEB_OIDC_CLIENT_ID=waypoint-web
WEB_OIDC_REDIRECT_URI=http://localhost/auth/callback
MOBILE_OIDC_CLIENT_ID=waypoint-driver
MOBILE_OIDC_REDIRECT_URI=dev.claptac.waypointdriver:/oauth2redirect

# PostgreSQL (single instance; each service uses its owned schema)
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint
POSTGRES_DB=waypoint
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://waypoint:waypoint@postgres:5432/waypoint?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO / S3-compatible object storage
MINIO_ENDPOINT=http://minio:9090
MINIO_BUCKET=waypoint-proof
# Draft 180-day deletion policy; leave disabled until the accountable owner
# approves it and production legal-hold procedures are in place.
DELIVERY_PROOF_RETENTION_ENABLED=false
DELIVERY_PROOF_RETENTION_DAYS=180

# OpenTelemetry (optional; no-op when unset)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Public URLs used by the web app at build/runtime
VITE_API_BASE_URL=/api/v1
VITE_OIDC_ISSUER=http://localhost:8090
VITE_OIDC_CLIENT_ID=waypoint-web
VITE_OIDC_REDIRECT_URI=http://localhost/auth/callback

# Optional OpenAI-compatible assistant provider (unset keeps agent safely unavailable)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
