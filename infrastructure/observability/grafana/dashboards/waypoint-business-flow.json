    {
      "id": 139,
      "type": "timeseries",
      "title": "Orders per hour: placed, allocated, deferred",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "expr": "sum(increase(waypoint_orders_created_total[1h]))",
          "legendFormat": "placed",
          "refId": "A"
        },
        {
          "expr": "sum(increase(waypoint_orders_allocated_total[1h]))",
          "legendFormat": "allocated",
          "refId": "B"
        },
        {
          "expr": "sum(increase(waypoint_orders_deferred_total[1h]))",
          "legendFormat": "deferred",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 140,
      "type": "timeseries",
