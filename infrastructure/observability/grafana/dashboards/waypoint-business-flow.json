    {
      "id": 141,
      "type": "row",
      "title": "How long things take",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 142,
      "type": "timeseries",
      "title": "Plan allocation time p50 / p95",
      "description": "Time the planner takes to allocate orders.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(waypoint_allocation_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(waypoint_allocation_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
