    {
      "id": 118,
      "type": "table",
      "title": "Slowest routes (p95, last 15 min)",
      "description": "",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "expr": "topk(12, histogram_quantile(0.95, sum by (le, service, path) (rate(http_request_duration_seconds_bucket{service=~\"$service\"}[15m]))))",
