  "panels": [
    {
      "id": 155,
      "type": "text",
      "title": "What this shows",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Dispatcher assistant (orchestrator) activity: requests, which read-only tools it called, failures, permission refusals and approvals. The order helper and dashboard assistant run in the separate assistants service; their reasons are in the Agent manager viewer, not here."
      }
    },
    {
      "id": 156,
      "type": "stat",
      "title": "Assistant questions",
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "expr": "sum(increase(waypoint_agent_requests_total[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
