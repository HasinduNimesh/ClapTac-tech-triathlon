    {
      "id": 162,
      "type": "timeseries",
      "title": "Questions and tool calls per hour",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "expr": "sum(increase(waypoint_agent_requests_total[1h]))",
          "legendFormat": "questions",
          "refId": "A"
        },
        {
          "expr": "sum(increase(waypoint_agent_tool_calls_total[1h]))",
          "legendFormat": "tool calls",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
