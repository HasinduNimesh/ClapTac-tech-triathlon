{
  "title": "Waypoint Operations",
  "uid": "waypoint-overview",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "HTTP request rate by service", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }, "targets": [{ "expr": "sum by (service) (rate(http_requests_total[5m]))", "legendFormat": "{{service}}" }] },
    { "id": 2, "type": "timeseries", "title": "HTTP error rate by service", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }, "targets": [{ "expr": "sum by (service) (rate(http_errors_total[5m]))", "legendFormat": "{{service}}" }] },
    { "id": 3, "type": "timeseries", "title": "HTTP p95 latency by service", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{service}}" }] },
    { "id": 4, "type": "stat", "title": "Services currently up", "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 }, "targets": [{ "expr": "sum(up{job=\"waypoint-services\"})" }] },
    { "id": 5, "type": "stat", "title": "Orders created", "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 }, "targets": [{ "expr": "sum(waypoint_orders_created_total)" }] },
    { "id": 6, "type": "timeseries", "title": "Planning activity", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }, "targets": [{ "expr": "sum(waypoint_plans_generated_total)", "legendFormat": "plans generated" }, { "expr": "sum(waypoint_orders_allocated_total)", "legendFormat": "orders allocated" }, { "expr": "sum(waypoint_orders_deferred_total)", "legendFormat": "orders deferred" }] },
    { "id": 7, "type": "timeseries", "title": "Constraint failures by reason", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }, "targets": [{ "expr": "sum by (reason) (waypoint_constraint_failures_total)", "legendFormat": "{{reason}}" }] },
    { "id": 8, "type": "timeseries", "title": "Loading activity", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 }, "targets": [{ "expr": "sum(waypoint_loading_sessions_started_total)", "legendFormat": "sessions started" }, { "expr": "sum(waypoint_loading_shortfalls_total)", "legendFormat": "shortfalls" }, { "expr": "sum(waypoint_loading_trips_ready_total)", "legendFormat": "trips ready" }] },
    { "id": 9, "type": "timeseries", "title": "Delivery outcomes", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 }, "targets": [{ "expr": "sum by (outcome) (waypoint_delivery_outcomes_total)", "legendFormat": "{{outcome}}" }] },
    { "id": 10, "type": "stat", "title": "Offline sync conflicts", "gridPos": { "h": 6, "w": 6, "x": 0, "y": 32 }, "targets": [{ "expr": "sum(waypoint_delivery_sync_conflicts_total)" }] },
    { "id": 11, "type": "timeseries", "title": "Receipt confirmations and issues", "gridPos": { "h": 6, "w": 12, "x": 6, "y": 32 }, "targets": [{ "expr": "sum(waypoint_receipt_confirmations_total)", "legendFormat": "confirmed" }, { "expr": "sum by (issue_type) (waypoint_receipt_issues_total)", "legendFormat": "issue {{issue_type}}" }] },
    { "id": 12, "type": "timeseries", "title": "Guarded assistant activity", "gridPos": { "h": 6, "w": 6, "x": 18, "y": 32 }, "targets": [{ "expr": "sum by (decision) (waypoint_agent_approvals_total)", "legendFormat": "approvals {{decision}}" }, { "expr": "sum(waypoint_agent_tool_failures_total)", "legendFormat": "tool failures" }] }
  ]
}
