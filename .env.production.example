# Copy to an untracked, owner-readable .env on the VM after provisioning.
# Keep each secret blank until its real value has been created.
ENVIRONMENT=production
AUTH_DISABLED=false
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=
POSTGRES_DB=waypoint
DATABASE_URL=
THUNDERID_PRIVATE_DIR=

OIDC_ISSUER=https://id.waypoint.claptac.dev
# Internal-only Docker network URLs; the issuer remains the public HTTPS URL.
OIDC_JWKS_URL=http://waypoint-thunderid-prod:8090/oauth2/jwks
OIDC_TOKEN_URL=http://waypoint-thunderid-prod:8090/oauth2/token
OIDC_AUDIENCE=https://waypoint.claptac.dev/api/v1
WEB_OIDC_CLIENT_ID=
WEB_OIDC_REDIRECT_URI=https://waypoint.claptac.dev/auth/callback
VITE_OIDC_ISSUER=https://id.waypoint.claptac.dev
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=https://waypoint.claptac.dev/auth/callback
VITE_OIDC_AUDIENCE=https://waypoint.claptac.dev/api/v1
VITE_API_BASE_URL=/api/v1

ORDER_M2M_CLIENT_SECRET=
PLANNING_M2M_CLIENT_SECRET=
FLEET_M2M_CLIENT_SECRET=
LOADING_M2M_CLIENT_SECRET=
DELIVERY_M2M_CLIENT_SECRET=
SHARED_M2M_CLIENT_SECRET=
INTEGRATION_M2M_CLIENT_SECRET=

# Private Cloudflare R2 bucket with a bucket-scoped object read/write key.
MINIO_ENDPOINT=
MINIO_BUCKET=waypoint-proof
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=auto
MINIO_AUTO_CREATE_BUCKET=false

# Leave disabled until the retention policy is approved.
DELIVERY_PROOF_RETENTION_ENABLED=false
DELIVERY_PROOF_RETENTION_DAYS=180
